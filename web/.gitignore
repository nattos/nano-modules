
# Bundled text-engine fonts — large OFL binaries fetched (not committed) by
# web/scripts/fetch_fonts.sh at a pinned commit + verified sha256. See FONTS.md.
public/fonts/*.ttf
public/fonts/*.otf
public/fonts/*.ttc
# CJK parity-test faces — fetched but NOT served (the app resolves OS CJK via
# Local Font Access); used only by the native parity harness.
test-fonts/

# Vite build output, and the electron-builder artifacts built from it. Both are
# derived: `npm run build:stage` regenerates dist/ and the staged resource root,
# `npm run package` regenerates release/ (hundreds of MB of Electron runtime).
dist/
release/

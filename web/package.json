{
  "name": "nano-modules-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stage": "bash scripts/stage_resources.sh",
    "build:stage": "npm run build && npm run stage",
    "package:arrangement": "NANO_PRODUCT=arrangement electron-builder --config electron-builder.config.cjs",
    "package:arrangement:mac": "NANO_PRODUCT=arrangement electron-builder --config electron-builder.config.cjs --mac",
    "package:arrangement:win": "NANO_PRODUCT=arrangement electron-builder --config electron-builder.config.cjs --win",
    "package:remote": "NANO_PRODUCT=remote electron-builder --config electron-builder.config.cjs",
    "package:remote:mac": "NANO_PRODUCT=remote electron-builder --config electron-builder.config.cjs --mac",
    "package:remote:win": "NANO_PRODUCT=remote electron-builder --config electron-builder.config.cjs --win",
    "package": "npm run package:arrangement && npm run package:remote",
    "test": "vitest --run",
    "test:e2e": "jest",
    "electron": "electron electron/main.cjs",
    "electron:remote": "NANO_PRODUCT=remote electron electron/main.cjs",
    "electron:arrangement": "NANO_PRODUCT=arrangement electron electron/main.cjs"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/expect-puppeteer": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@webgpu/types": "^0.1.60",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.10.6",
    "jest": "^29.7.0",
    "jest-puppeteer": "^10.0.1",
    "lit": "^2.8.0",
    "mobx": "^6.15.0",
    "puppeteer": "^22.10.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.2.2",
    "vite": "^7.1.9",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "codemirror": "^6.0.2",
    "immer": "^11.1.4",
    "line-awesome": "^1.3.0",
    "marked": "^12.0.2",
    "mp4-muxer": "^5.2.2"
  },
  "description": "Nano Repatch — live visual synthesis",
  "author": "nattos",
  "main": "electron/main.cjs"
}
